{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CODEX_PLUGIN_ROOT}/hooks/gemini_video_hook.py\"",
            "timeout": 8,
            "statusMessage": "Scanning for .mp4"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CODEX_PLUGIN_ROOT}/hooks/gemini_video_hook.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CODEX_PLUGIN_ROOT}/hooks/gemini_video_hook.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
