{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CODEX_PLUGIN_ROOT}/hooks/human_md_hook.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CODEX_PLUGIN_ROOT}/hooks/human_md_hook.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CODEX_PLUGIN_ROOT}/hooks/human_md_hook.py"
          }
        ]
      }
    ]
  }
}
