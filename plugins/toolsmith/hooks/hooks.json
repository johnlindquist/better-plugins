{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/capture_pre_tool_use.js\"",
            "timeout": 2,
            "statusMessage": "Recording prompt intent"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/capture_pre_tool_use.js\"",
            "timeout": 2,
            "statusMessage": "Recording tool usage"
          }
        ]
      }
    ]
  }
}
